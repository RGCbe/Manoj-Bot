//@version=6
// =============================================================================
//  Weak Zones (Manoj-Bot)  -  TradingView / Pine Script v6
// =============================================================================
//  Marks "weak point / reversal zones" using the trade-plan rules (pages 1-3):
//
//   1. FORMATION - 3 same-colour candles, each breaking the previous
//        3 green -> higher highs -> bullish reversal -> SUPPORT zone
//        3 red   -> lower  lows  -> bearish reversal -> RESISTANCE zone
//
//   2. BAND - drawn body -> wick, anchored to the nearest low/high. The box
//      starts at the lowest (support) / highest (resistance) candle and ends
//      at the candle that breaks it:
//        support   : top = lowest body,  bottom = lowest wick
//        resistance: top = highest wick, bottom = highest body
//
//   3. LIVE / DEAD - stays LIVE while price only touches into the band;
//      DIES when a wick OR body fully breaks through the far edge, and the
//      box stops (right edge frozen) + turns grey/dotted at that bar.
//
//  Mirrors MQL5/Indicators/WeakZones.mq5 and tools/weak_zones_ref.py.
// =============================================================================
indicator("Weak Zones (Manoj-Bot)", overlay = true, max_boxes_count = 500)

// ---- inputs -----------------------------------------------------------------
lookback    = input.int(2, "Anchor lookback (candles before the 1st)", minval = 0)
allowDoji   = input.bool(false, "Allow a doji inside the 3-candle run")
deathBuf    = input.float(0.0, "Death buffer (price beyond far edge)", minval = 0.0)
extendRight = input.bool(true, "Extend live zones to the current bar")
maxZones    = input.int(60, "Max zones kept", minval = 1)

supFill   = input.color(color.new(color.lime, 82), "Live support fill",    group = "Colours")
resFill   = input.color(color.new(color.red,  82), "Live resistance fill", group = "Colours")
deadFill  = input.color(color.new(color.gray, 88), "Dead zone fill",       group = "Colours")
supBord   = input.color(color.green, "Live support border",    group = "Colours")
resBord   = input.color(color.red,   "Live resistance border", group = "Colours")
deadBord  = input.color(color.gray,  "Dead border",            group = "Colours")

// ---- zone state (parallel arrays; index i = one zone) -----------------------
var array<box>   zBox   = array.new<box>()
var array<bool>  zSup   = array.new<bool>()    // true = support (3 green)
var array<float> zTop   = array.new<float>()
var array<float> zBot   = array.new<float>()
var array<bool>  zAlive = array.new<bool>()

// candle colour at a history offset: 1 = green, -1 = red, 0 = doji
cColor(offset) =>
    o = open[offset]
    c = close[offset]
    c > o ? 1 : c < o ? -1 : 0

// -----------------------------------------------------------------------------
//  Act once per closed bar
// -----------------------------------------------------------------------------
if barstate.isconfirmed
    // (a) age every live zone against the just-closed bar (offset 0)
    if array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            if array.get(zAlive, i)
                isSup = array.get(zSup, i)
                zt    = array.get(zTop, i)
                zb    = array.get(zBot, i)
                b     = array.get(zBox, i)
                died  = isSup ? (low < zb - deathBuf) : (high > zt + deathBuf)
                if died
                    array.set(zAlive, i, false)
                    box.set_right(b, bar_index)
                    box.set_bgcolor(b, deadFill)
                    box.set_border_color(b, deadBord)
                    box.set_border_style(b, line.style_dotted)
                else if extendRight
                    box.set_right(b, bar_index + 1)

    // (b) detect a formation completing on this bar (c3=0, c2=1, c1=2)
    col1 = cColor(2)
    col2 = cColor(1)
    col3 = cColor(0)

    sign     = 0
    nonDoji  = 0
    conflict = false
    if col1 != 0
        nonDoji += 1
        sign := col1
    if col2 != 0
        nonDoji += 1
        if sign == 0
            sign := col2
        else if sign != col2
            conflict := true
    if col3 != 0
        nonDoji += 1
        if sign == 0
            sign := col3
        else if sign != col3
            conflict := true

    valid = not conflict and sign != 0 and (allowDoji or nonDoji == 3)
    wEnd  = 2 + lookback

    if valid and bar_index > wEnd
        isGreen = sign == 1
        breaks  = isGreen ? (high[1] > high[2] and high[0] > high[1]) : (low[1] < low[2] and low[0] < low[1])
        if breaks
            float top    = na
            float bottom = na
            int   extreme = 0          // offset of the lowest / highest candle
            if isGreen
                bottom := low[0]
                top    := math.min(open[0], close[0])
                for k = 0 to wEnd
                    if low[k] < bottom
                        bottom := low[k]
                        extreme := k
                    top := math.min(top, math.min(open[k], close[k]))
            else
                top    := high[0]
                bottom := math.max(open[0], close[0])
                for k = 0 to wEnd
                    if high[k] > top
                        top := high[k]
                        extreme := k
                    bottom := math.max(bottom, math.max(open[k], close[k]))
            if top <= bottom
                top := bottom + syminfo.mintick

            // skip if it overlaps a still-live zone of the same type
            overlap = false
            if array.size(zBox) > 0
                for i = 0 to array.size(zBox) - 1
                    if array.get(zAlive, i) and array.get(zSup, i) == isGreen and not (top < array.get(zBot, i) or bottom > array.get(zTop, i))
                        overlap := true

            if not overlap
                leftIdx  = bar_index - extreme   // box starts at the lowest/highest candle
                rightIdx = extendRight ? bar_index + 1 : bar_index
                fill = isGreen ? supFill : resFill
                bord = isGreen ? supBord : resBord
                b = box.new(leftIdx, top, rightIdx, bottom, border_color = bord, bgcolor = fill, border_width = 1)
                array.push(zBox, b)
                array.push(zSup, isGreen)
                array.push(zTop, top)
                array.push(zBot, bottom)
                array.push(zAlive, true)
                if array.size(zBox) > maxZones
                    box.delete(array.shift(zBox))
                    array.shift(zSup)
                    array.shift(zTop)
                    array.shift(zBot)
                    array.shift(zAlive)

// keep live zones stretched to the developing bar
if extendRight and array.size(zBox) > 0
    for i = 0 to array.size(zBox) - 1
        if array.get(zAlive, i)
            box.set_right(array.get(zBox, i), bar_index + 1)
