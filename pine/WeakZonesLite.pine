//@version=6
// Weak Zones Lite (Manoj-Bot) - paste-proof flat version: no indented blocks.
// Marks the most recent support zone (from 3 green candles, each breaking the
// previous) and the most recent resistance zone (from 3 red candles).
// Band = lowest body -> lowest wick (support) / highest wick -> highest body
// (resistance) over the formation + lookback window. The zone stays live while
// price only touches into it and ends at the candle that fully breaks it.
// Differences vs WeakZones.pine: keeps one zone per side (not a history), and
// the band starts drawing at the formation candle rather than the extreme one.
indicator('Weak Zones Lite (Manoj-Bot)', overlay = true)
lookback = input.int(2, 'Anchor lookback (candles before the 1st)', minval = 0)
deathBuf = input.float(0.0, 'Death buffer (price beyond far edge)', minval = 0.0)
supFillC = input.color(color.new(color.green, 72), 'Support zone fill')
resFillC = input.color(color.new(color.red, 72), 'Resistance zone fill')
w = 3 + lookback
bullForm = barstate.isconfirmed and close > open and close[1] > open[1] and close[2] > open[2] and high > high[1] and high[1] > high[2]
bearForm = barstate.isconfirmed and close < open and close[1] < open[1] and close[2] < open[2] and low < low[1] and low[1] < low[2]
newSupBot = ta.lowest(low, w)
newSupTop = ta.lowest(math.min(open, close), w)
newResTop = ta.highest(high, w)
newResBot = ta.highest(math.max(open, close), w)
var float supTop = na
var float supBot = na
var float resTop = na
var float resBot = na
supDead = barstate.isconfirmed and not na(supBot) and low[1] < supBot - deathBuf
resDead = barstate.isconfirmed and not na(resTop) and high[1] > resTop + deathBuf
supTop := bullForm ? newSupTop : supDead ? na : supTop
supBot := bullForm ? newSupBot : supDead ? na : supBot
resTop := bearForm ? newResTop : resDead ? na : resTop
resBot := bearForm ? newResBot : resDead ? na : resBot
hidden = color.new(color.gray, 100)
pSupTop = plot(supTop, 'Support top', color = hidden, style = plot.style_linebr)
pSupBot = plot(supBot, 'Support bottom', color = hidden, style = plot.style_linebr)
pResTop = plot(resTop, 'Resistance top', color = hidden, style = plot.style_linebr)
pResBot = plot(resBot, 'Resistance bottom', color = hidden, style = plot.style_linebr)
fill(pSupTop, pSupBot, color = supFillC, title = 'Support zone')
fill(pResTop, pResBot, color = resFillC, title = 'Resistance zone')
